{
  "schemaVersion": 1,
  "runtimeRoot": "%LOCALAPPDATA%\\FadiBrowserV2",
  "host": "127.0.0.1",
  "port": 8951,
  "maxConcurrentSessions": 5,
  "queueMaxDepth": 10,
  "queueWaitTimeoutMs": 30000,
  "maxSessionsPerClient": 3,
  "leaseTtlMs": 300000,
  "recoveryWindowMs": 120000,
  "retentionDays": 30,
  "browserPools": {},
  "clients": {
    "fadi-gpt": {
      "defaultAuthProfile": "fadi",
      "allowedAuthProfiles": ["fadi"]
    },
    "goilot-gpt": {
      "defaultAuthProfile": "goilot",
      "allowedAuthProfiles": ["goilot"]
    },
    "goilot-claude": {
      "defaultAuthProfile": "goilot-claude",
      "allowedAuthProfiles": ["goilot-claude"]
    },
    "maintenance": {
      "defaultAuthProfile": "public",
      "allowedAuthProfiles": ["public", "fadi", "goilot", "goilot-claude"]
    }
  },
  "authProfiles": {
    "public": {
      "persistent": false,
      "mode": "portable"
    },
    "fadi": {
      "persistent": true,
      "mode": "profile_bound"
    },
    "goilot": {
      "persistent": true,
      "mode": "profile_bound",
      "headed": true
    },
    "goilot-claude": {
      "persistent": true,
      "mode": "profile_bound"
    }
  }
}
